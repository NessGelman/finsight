# Get a free FRED API key at: https://fred.stlouisfed.org/docs/api/api_key.html
# Takes 30 seconds, no credit card required.
VITE_FRED_API_KEY=your_32_char_key_here

# ── Data Collection (optional — enables Supabase backend) ────────────────────
# Create a FREE Supabase project at https://supabase.com
# Run SUPABASE_SETUP.sql in your project's SQL editor first
# Then copy these values from Settings > API in your Supabase dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your_anon_key_here

# Without these, all data is stored locally only (still fully functional).
